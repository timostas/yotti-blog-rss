{
  "schemaVersion": 1,
  "objective": {
    "primary": "organic_search_traffic",
    "horizonDays": 90
  },
  "production": {
    "targetContentUnitsPerDay": null,
    "dailyPublicationTime": "18:30",
    "dailyPublicationTimezone": "Europe/Moscow",
    "localesPerUnit": ["ru", "en"],
    "maximumPublishedPagesPerDay": null,
    "frequencyLimitMode": "temporarily_unlimited_by_owner",
    "publicationGate": "manual_yotti_admin_sync",
    "exceptions": []
  },
  "contentStrategy": {
    "commercialGoal": "qualified_esim_traffic",
    "countryRotationWindowUnits": 14,
    "maximumConnectivityLedUnitsPerFive": 3,
    "maximumSameRegionInARow": 2,
    "formats": [
      { "key": "destination-inspiration", "share": 10 },
      { "key": "route-or-itinerary", "share": 10 },
      { "key": "culture-food-or-local-experience", "share": 15 },
      { "key": "seasonal-trip-ideas", "share": 10 },
      { "key": "practical-travel-scenario", "share": 5 },
      { "key": "connectivity-and-esim", "share": 50 }
    ],
    "avoidByDefault": [
      "breaking_news",
      "visa_or_immigration_rules",
      "health_or_safety_advice",
      "live_prices_or_timetables",
      "legal_or_regulatory_explanations"
    ],
    "requiredSearchFeatures": [
      "direct_answer_near_start",
      "descriptive_question_headings",
      "key_takeaways",
      "short_faq",
      "natural_country_esim_link"
    ]
  },
  "quality": {
    "minimumSources": 2,
    "targetSources": { "evergreen": 2, "guide": 2 },
    "minimumCountrySpecificFacts": 3,
    "minimumUtilityScore": 80,
    "minimumOriginalValueScore": 80,
    "minimumFactSupportScore": 80,
    "maximumBlockingReviewMinutes": 4,
    "requireNaturalLocalization": true,
    "rejectMechanicalTranslation": true
  },
  "creativeStrategy": {
    "aspectRatio": "16:9",
    "maximumGenerationAttempts": 1,
    "conceptRotationWindowUnits": 10,
    "forbidTextAndThirdPartyLogos": true,
    "avoidGenericPhoneAsMainSubject": true,
    "visualArchetypes": [
      "cinematic-landscape",
      "street-life",
      "food-or-craft-detail",
      "distinctive-architecture",
      "nature-and-wildlife",
      "local-human-activity",
      "transport-as-travel-story",
      "blue-hour-or-night-scene"
    ]
  },
  "modelRouting": {
    "planningAndRoutineDrafts": { "model": "gpt-5.6-sol", "effort": "high" },
    "literaryEditorialPolish": { "model": "gpt-5.6-sol", "effort": "high", "scope": "voice_only_no_new_facts" },
    "metadataAndMechanicalChecks": { "model": "gpt-5.6-luna", "effort": "low" },
    "highRiskResearchAndFinalAudit": { "mode": "exclude_topic_from_daily_flow" },
    "escalateOnlyWhen": []
  },
  "budget": {
    "maximumGenerationAttemptsPerLocale": 1,
    "maximumQualityRepairAttempts": 1,
    "maximumResearchSourcesPerUnit": 2,
    "maximumWebSearchBatchesPerUnit": 1,
    "reuseResearchAcrossLocales": true,
    "batchRelatedTopics": true,
    "stopWhenDailyBudgetUnavailable": false
  },
  "scaleGate": {
    "minimumSampleDays": 14,
    "minimumIndexationRate": 0.7,
    "maximumCriticalCorrectionRate": 0.05,
    "minimumOnTimeDeliveryRate": 0.9,
    "pauseOnDuplicateOrUnsupportedClaim": true
  }
}
